# ==========================================
# ==========================================
# AI Model API Keys (Gemini 무료 키 또는 OpenAI 키 중 택 1)
# ==========================================
# Google AI Studio에서 무료 발급: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (실제 API 조회 검증 완료 최신 Flash Lite 모델)
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# OpenAI API Key (선택사항)
OPENAI_API_KEY=

# ==========================================
# Firebase Firestore 설정
# ==========================================
# 방법 A: 서비스 계정 키 파일 경로 (로컬용)
FIREBASE_SERVICE_ACCOUNT_PATH=service_account.json

# 방법 B: 서비스 계정 키 JSON 문자열 전체 (Render/배포용)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ==========================================
# 서버 및 배포 설정
# ==========================================
PORT=8000
HOST=0.0.0.0
# CORS 허용 도메인 (콤마로 구분, 프론트엔드 배포 URL 포함)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:5500,https://*.vercel.app
